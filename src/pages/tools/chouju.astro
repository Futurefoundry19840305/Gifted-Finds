---
import Base from "../../layouts/Base.astro";
import tools from "../../data/tools.json";
const t = tools.chouju;
---
<Base title="長寿祝いの早見表" description="還暦・古希・喜寿・米寿など、長寿祝いの名前と年齢、お祝いの色を一覧にしました。今の年齢を入れると、これから迎える長寿祝いと、あと何年かがわかります。" crumbs={[{ name: "贈りものの豆知識", href: "/tips/" }, { name: "長寿祝いの早見表", href: "/tools/chouju/" }]}>
  <h1>長寿祝いの早見表</h1>
  {t.status !== "published" ? <p class="muted">準備中です。</p> : (
    <>
      <form class="tool" data-chouju data-rows={JSON.stringify(t.rows)} onsubmit="return false">
        <label for="age">お祝いする方の今の年齢（満年齢）</label>
        <input id="age" name="age" type="number" inputmode="numeric" min="0" max="120" placeholder="例：58" />
        <div aria-live="polite" data-result><p class="result">年齢を入れると、これから迎える長寿祝いが表示されます。</p></div>
      </form>
      <div class="table-scroll"><table>
        <thead><tr><th scope="col">名前</th><th scope="col">年齢</th><th scope="col">お祝いの色</th></tr></thead>
        <tbody>{t.rows.map((r) => <tr><th scope="row">{r.name}</th><td>{r.age}歳</td><td>{r.color}</td></tr>)}</tbody>
      </table></div>
      <p class="note">満年齢で祝うのが一般的になっていますが、数え年で祝う地域やご家庭もあります。</p>
      <p><a href="/scene/chouju-iwai/">長寿祝いの品を選ぶ</a></p>
    </>
  )}
  <script src="/js/tools.js" defer></script>
</Base>
