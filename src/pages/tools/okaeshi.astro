---
import Base from "../../layouts/Base.astro";
import tools from "../../data/tools.json";
const t = tools.okaeshi;
---
<Base title="お返し（内祝い）の目安計算" description="いただいたお祝いの金額を入れると、内祝いの目安（3分の1から半額）を計算します。目上の方からの高額なお祝いへの考え方もあわせて確認できます。" crumbs={[{ name: "贈りものの豆知識", href: "/tips/" }, { name: "お返しの目安計算", href: "/tools/okaeshi/" }]}>
  <h1>お返し（内祝い）の目安計算</h1>
  {t.status !== "published" ? <p class="muted">準備中です。</p> : (
    <form class="tool" data-okaeshi data-min={t.minRate} data-max={t.maxRate} onsubmit="return false">
      <label for="amount">いただいたお祝いの金額（円）</label>
      <input id="amount" name="amount" type="number" inputmode="numeric" min="0" step="1000" placeholder="例：30000" />
      <p class="result" aria-live="polite" data-result>金額を入れると、目安が表示されます。</p>
      <p class="note">3分の1から半額が一般的な目安です。目上の方から高額をいただいた場合は、3分の1程度でも失礼にはなりません。</p>
      <p><a href="/scene/kekkon-shussan/">内祝いの品を選ぶ</a></p>
    </form>
  )}
  <script src="/js/tools.js" defer></script>
</Base>
