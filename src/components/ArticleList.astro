---
import { genreName, fmtDate } from "../lib";
interface Props { items: { id: string; data: { title: string; description: string; genre: string; updated: Date } }[]; empty?: string }
const { items, empty = "記事を準備中です。" } = Astro.props;
---
{items.length === 0 ? <p class="muted">{empty}</p> : (
  <ul class="article-list">
    {items.map((a) => (
      <li><a href={`/${a.data.genre}/${a.id}/`}><span class="tag">{genreName(a.data.genre)}</span><strong>{a.data.title}</strong><span class="desc">{a.data.description}</span><span class="date">{fmtDate(a.data.updated)}更新</span></a></li>
    ))}
  </ul>
)}
