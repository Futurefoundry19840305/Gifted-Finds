---
import site from "../site.config.json";
interface Props { title: string; description: string; noindex?: boolean; jsonld?: object[]; crumbs?: { name: string; href: string }[] }
const { title, description, noindex = false, jsonld = [], crumbs = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const fullTitle = Astro.url.pathname === "/" ? `${site.name}｜${site.tagline}` : `${title}｜${site.name}`;
const ogImage = new URL("/og-default.png", Astro.site).toString();
const breadcrumb = crumbs.length ? [{
  "@context": "https://schema.org", "@type": "BreadcrumbList",
  itemListElement: [{ name: "ホーム", href: "/" }, ...crumbs].map((c, i) => ({
    "@type": "ListItem", position: i + 1, name: c.name, item: new URL(c.href, Astro.site).toString() })),
}] : [];
const nav = [
  ["/season/", "季節特集"], ["/manners/", "贈りものマナー"], ["/gift/", "ギフト"], ["/kaden/", "季節家電"], ["/food/", "食品"], ["/outdoor/", "アウトドア"],
];
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:site_name" content={site.name} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/styles.css" />
  {[...breadcrumb, ...jsonld].map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
</head>
<body>
  <p class="pr-bar">当サイトはプロモーション（広告）を含みます。<a href="/disclaimer/">広告について</a></p>
  <header class="site-header">
    <a class="logo" href="/">{site.name}</a>
    <nav aria-label="メインメニュー"><ul>{nav.map(([href, label]) => <li><a href={href} aria-current={Astro.url.pathname.startsWith(href) ? "page" : undefined}>{label}</a></li>)}</ul></nav>
  </header>
  {crumbs.length > 0 && (
    <nav class="crumbs" aria-label="パンくずリスト"><ol><li><a href="/">ホーム</a></li>{crumbs.map((c, i) => <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}</li>)}</ol></nav>
  )}
  <main id="main"><slot /></main>
  <footer class="site-footer">
    <ul>
      <li><a href="/about/">運営者情報</a></li>
      <li><a href="/privacy/">プライバシーポリシー</a></li>
      <li><a href="/disclaimer/">広告表記・免責事項</a></li>
      <li><a href="/contact/">お問い合わせ</a></li>
    </ul>
    <p class="credit"><a href="https://developers.rakuten.com/" rel="noopener">Supported by Rakuten Developers</a></p>
    <p>© {new Date().getFullYear()} {site.name}</p>
  </footer>
</body>
</html>
